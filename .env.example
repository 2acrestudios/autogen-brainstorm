# Claude Agent SDK Configuration
# Copy this file to .env and fill in your actual API key

# Anthropic API Key (required)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-api-key-here

# Optional: Claude Model Selection
# Default: claude-sonnet-4-20250514 (Claude Sonnet 4.5)
# Other options: claude-opus-4-20250514, claude-haiku-4-20250514
# CLAUDE_MODEL=claude-sonnet-4-20250514

# Optional: Logging Configuration
# LOG_LEVEL=INFO
# LOG_DIR=./brainstorm_logs
